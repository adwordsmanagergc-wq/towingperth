---
// Hub for the compact keyword landing pages.
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/PageHero.astro';
import CTASection from '~/components/CTASection.astro';
import { GROUPS, groupOf, label } from '~/lib/landings';

const all = (await getCollection('landings')).sort((a, b) => a.data.h1.localeCompare(b.data.h1));
const groups = GROUPS.map((g) => ({ ...g, items: all.filter((l) => groupOf(l.data.url).key === g.key) })).filter((g) => g.items.length);
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Towing jobs', href: '/towing' },
];
---

<BaseLayout
  title="Towing Jobs We Handle in Perth | Quik Tow & Transport"
  description="Motorbikes, caravans, EVs, machinery, airport and freeway breakdowns, auction pickups and more. Every towing job across Perth, 24/7. Call 0419 857 070."
  path="/towing"
  crumbs={crumbs}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="24/7 across Perth"
    h1="Every towing job, one call"
    lead="Whatever you need moved and wherever it's stuck, we have a tilt tray for it. Find your job below or call 0419 857 070."
  />
  <section class="py-14 sm:py-20">
    <div class="wrap grid gap-12 sm:grid-cols-2 lg:grid-cols-3">
      {
        groups.map((g) => (
          <div>
            <h2 class="text-3xl">{g.name}</h2>
            <ul class="mt-4 space-y-1">
              {g.items.map((l) => (
                <li>
                  <a href={l.data.url} class="inline-flex min-h-10 items-center text-mute hover:text-hivis">{label(l)}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
  <CTASection position="towing-hub-cta-band" />
</BaseLayout>
