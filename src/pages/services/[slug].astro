---
import { getCollection, render, getEntries } from 'astro:content';
import Check from '@lucide/astro/icons/check';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/PageHero.astro';
import ServiceCard from '~/components/ServiceCard.astro';
import ServiceIcon from '~/components/ServiceIcon.astro';
import FAQ from '~/components/FAQ.astro';
import CTASection from '~/components/CTASection.astro';
import CallButton from '~/components/CallButton.astro';
import { TOP_SUBURBS } from '~/config/site';
import { faqPage, service } from '~/lib/schema';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const path = `/services/${entry.id}`;
const others = (await getCollection('services')).filter((s) => s.id !== entry.id).sort((a, b) => a.data.order - b.data.order);
const regions = (await getCollection('regions')).sort((a, b) => a.data.order - b.data.order);
const top = await getEntries(TOP_SUBURBS.map((id) => ({ collection: 'suburbs' as const, id })));
const topSuburbs = top.filter(Boolean);

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services' },
  { name: data.name, href: path },
];
const schema = [
  service({
    name: `${data.name} in Perth`,
    serviceType: data.name,
    description: data.metaDescription,
    path,
  }),
  faqPage(data.faqs),
];
---

<BaseLayout title={data.metaTitle} description={data.metaDescription} path={path} og="service" crumbs={crumbs} schema={schema}>
  <PageHero crumbs={crumbs} eyebrow="24/7 across Perth" h1={data.h1} lead={data.lead} />

  <section class="py-14 sm:py-20">
    <div class="wrap grid gap-12 lg:grid-cols-[minmax(0,1fr)_22rem]">
      <article class="prose-copy">
        <Content />
      </article>
      <aside class="space-y-6 lg:sticky lg:top-28 lg:self-start">
        <div class="rounded-lg border border-steel bg-coal p-6">
          <div class="flex items-center gap-3">
            <span class="grid size-12 place-items-center rounded-md bg-hivis text-ink"><ServiceIcon name={data.icon} class="size-7" /></span>
            <h2 class="text-2xl">What's included</h2>
          </div>
          <ul class="mt-5 space-y-2.5">
            {
              data.included.map((i) => (
                <li class="flex gap-2.5 text-mute">
                  <Check class="mt-0.5 size-5 shrink-0 text-hivis" stroke-width={3} aria-hidden="true" />
                  {i}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="rounded-lg border border-steel bg-coal p-6">
          <h2 class="text-2xl">Vehicles we handle</h2>
          <ul class="mt-4 flex flex-wrap gap-2">
            {data.vehicles.map((v) => <li class="rounded-full border border-steel px-3 py-1.5 text-sm text-white">{v}</li>)}
          </ul>
        </div>
        <div class="rounded-lg bg-hivis p-6 text-ink">
          <p class="font-display text-2xl font-extrabold uppercase">Need it now?</p>
          <p class="mt-2 font-medium">We answer 24/7 and quote upfront.</p>
          <CallButton position="service-sidebar" variant="dark" size="md" class="mt-4 w-full" />
        </div>
      </aside>
    </div>
  </section>

  <section class="on-light bg-paper py-14 text-ink sm:py-20" aria-labelledby="steps-heading">
    <div class="wrap">
      <p class="eyebrow">How it works</p>
      <h2 id="steps-heading" class="mt-3 text-4xl sm:text-5xl">{data.name}, step by step</h2>
      <ol class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          data.steps.map((s, i) => (
            <li class="reveal rounded-lg border-2 border-ink bg-white p-6">
              <span class="font-display text-5xl font-extrabold text-hivis-deep">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-2 text-2xl">{s.title}</h3>
              <p class="mt-2 text-slate">{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="py-14 sm:py-20" aria-labelledby="areas-heading">
    <div class="wrap">
      <p class="eyebrow">Service area</p>
      <h2 id="areas-heading" class="mt-3 text-4xl sm:text-5xl">{data.name} in every Perth region</h2>
      <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
        {
          regions.map((r) => (
            <li>
              <a href={`/areas/${r.id}`} class="flex min-h-14 items-center rounded-md border border-steel bg-coal px-4 font-display text-lg font-bold uppercase hover:border-hivis hover:text-hivis">
                {r.data.name}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-8 text-mute">Popular suburbs:</p>
      <ul class="mt-3 flex flex-wrap gap-2">
        {
          topSuburbs.map((s) => (
            <li>
              <a href={`/areas/${s!.id}`} class="inline-flex min-h-11 items-center rounded-full border border-steel px-4 text-white hover:border-hivis hover:text-hivis">
                Tow truck {s!.data.name}
              </a>
            </li>
          ))
        }
        <li><a href="/areas" class="inline-flex min-h-11 items-center px-2 font-semibold text-hivis underline underline-offset-4">All suburbs</a></li>
      </ul>
    </div>
  </section>

  <section class="border-t border-steel bg-coal py-14 sm:py-20" aria-labelledby="faq-heading">
    <div class="wrap grid gap-10 lg:grid-cols-[1fr_2fr]">
      <div>
        <p class="eyebrow">FAQ</p>
        <h2 id="faq-heading" class="mt-3 text-4xl sm:text-5xl">{data.name} questions</h2>
      </div>
      <FAQ faqs={data.faqs} openFirst />
    </div>
  </section>

  <section class="py-14 sm:py-20" aria-labelledby="other-heading">
    <div class="wrap">
      <h2 id="other-heading" class="text-3xl sm:text-4xl">Other services</h2>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {others.map((s) => <ServiceCard href={`/services/${s.id}`} title={s.data.name} blurb={s.data.cardBlurb} icon={s.data.icon} />)}
      </div>
    </div>
  </section>

  <CTASection position="service-cta-band" />
</BaseLayout>
