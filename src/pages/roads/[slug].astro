---
import { getCollection, getEntries, render, type CollectionEntry } from 'astro:content';
import TriangleAlert from '@lucide/astro/icons/triangle-alert';
import MapPin from '@lucide/astro/icons/map-pin';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/PageHero.astro';
import FAQ from '~/components/FAQ.astro';
import CTASection from '~/components/CTASection.astro';
import CallButton from '~/components/CallButton.astro';
import { faqPage } from '~/lib/schema';

export async function getStaticPaths() {
  const roads = await getCollection('roads');
  return roads.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const suburbs = (await getEntries(data.suburbs)).filter(Boolean) as CollectionEntry<'suburbs'>[];
const others = (await getCollection('roads')).filter((r) => r.id !== entry.id).sort((a, b) => a.data.order - b.data.order);
const path = `/roads/${entry.id}`;
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Dangerous roads', href: '/roads' },
  { name: data.name, href: path },
];
---

<BaseLayout title={data.metaTitle} description={data.metaDescription} path={path} og="road" crumbs={crumbs} schema={[faqPage(data.faqs)]}>
  <PageHero crumbs={crumbs} eyebrow="Perth road safety" h1={data.h1} lead={data.lead} />

  <section class="py-14 sm:py-20">
    <div class="wrap grid gap-12 lg:grid-cols-[minmax(0,1fr)_22rem]">
      <article class="prose-copy">
        <Content />
      </article>
      <aside class="space-y-6 lg:sticky lg:top-28 lg:self-start">
        <div class="rounded-lg border-2 border-hivis bg-coal p-6">
          <h2 class="flex items-center gap-2 text-2xl">
            <TriangleAlert class="size-6 text-hivis" aria-hidden="true" /> Safety tips
          </h2>
          <ul class="mt-4 space-y-3">
            {
              data.safetyTips.map((t) => (
                <li class="flex gap-3 text-mute">
                  <span class="mt-2 size-2 shrink-0 bg-hivis" aria-hidden="true" />
                  {t}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="rounded-lg bg-hivis p-6 text-ink">
          <p class="font-display text-2xl font-extrabold uppercase">Crashed on {data.name}?</p>
          <p class="mt-2 font-medium">We tow 24/7 and bill your insurer directly.</p>
          <CallButton position="road-sidebar" variant="dark" size="md" class="mt-4 w-full" />
        </div>
      </aside>
    </div>
  </section>

  <section class="on-light bg-paper py-14 text-ink sm:py-20" aria-labelledby="along-heading">
    <div class="wrap">
      <h2 id="along-heading" class="text-4xl sm:text-5xl">Towing along {data.name}</h2>
      <ul class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
        {
          suburbs.map((s) => (
            <li>
              <a href={`/areas/${s.id}`} class="flex min-h-14 items-center gap-2 rounded-md border-2 border-ink bg-white px-4 font-semibold hover:bg-hivis">
                <MapPin class="size-4 shrink-0" aria-hidden="true" />
                Tow truck {s.data.name}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-8">
        <a href="/services/accident-towing-perth" class="font-display text-xl font-bold uppercase underline decoration-hivis-deep decoration-4 underline-offset-4">
          About our accident towing
        </a>
      </p>
    </div>
  </section>

  <section class="border-b border-steel bg-coal py-14 sm:py-20" aria-labelledby="faq-heading">
    <div class="wrap grid gap-10 lg:grid-cols-[1fr_2fr]">
      <div>
        <p class="eyebrow">FAQ</p>
        <h2 id="faq-heading" class="mt-3 text-4xl sm:text-5xl">{data.name} questions</h2>
      </div>
      <FAQ faqs={data.faqs} openFirst />
    </div>
  </section>

  <section class="py-14 sm:py-20" aria-labelledby="more-roads">
    <div class="wrap">
      <h2 id="more-roads" class="text-3xl sm:text-4xl">More dangerous roads</h2>
      <ul class="mt-6 flex flex-wrap gap-2">
        {
          others.map((r) => (
            <li>
              <a href={`/roads/${r.id}`} class="inline-flex min-h-11 items-center rounded-full border border-steel px-4 hover:border-hivis hover:text-hivis">
                {r.data.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CTASection heading={`Need a tow on ${data.name}?`} position="road-cta-band" />
</BaseLayout>
