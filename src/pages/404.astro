---
import BaseLayout from '~/layouts/BaseLayout.astro';
import CallButton from '~/components/CallButton.astro';
import AreaSearch from '~/components/AreaSearch.astro';
import Button from '~/components/Button.astro';
---

<BaseLayout title="Page not found | Quik Tow & Transport" description="We couldn't find that page. Call 0419 857 070 for a tow anywhere in Perth, 24/7." path="/404" noindex>
  <section class="py-16 sm:py-24">
    <div class="wrap max-w-3xl">
      <p class="eyebrow">Error 404</p>
      <h1 class="mt-3 text-5xl sm:text-7xl">Wrong turn. We can still get you moving.</h1>
      <p class="mt-6 text-lg text-mute">The page you were after isn't here. If you need a tow, call us now. We're open 24/7 across Perth.</p>
      <div class="mt-8"><CallButton position="404" size="xl" /></div>
      <h2 class="mt-14 text-3xl">Find your suburb</h2>
      <div class="mt-4"><AreaSearch id="area-search-404" /></div>
      <div class="mt-10 flex flex-wrap gap-3">
        <Button href="/" variant="secondary" size="md">Home</Button>
        <Button href="/services" variant="secondary" size="md">Services</Button>
        <Button href="/areas" variant="secondary" size="md">All areas</Button>
        <Button href="/contact" variant="secondary" size="md">Contact</Button>
      </div>
      <h2 class="mt-14 text-3xl">Our main services</h2>
      <ul class="mt-4 grid gap-1 sm:grid-cols-2">
        {
          [
            ['/car-towing-perth', 'Car towing Perth'],
            ['/services/breakdown-towing-perth', 'Breakdown towing'],
            ['/services/accident-towing-perth', 'Accident towing'],
            ['/towing/24-hour-towing-perth', '24 hour towing'],
            ['/truck-towing-perth', 'Truck and bus towing'],
            ['/tilt-tray-perth', 'Tilt tray hire'],
            ['/services/container-transport-perth', 'Container towing'],
            ['/towing-cost-perth', 'Tow truck prices'],
          ].map(([href, name]) => <li><a href={href} class="inline-flex min-h-10 items-center text-hivis underline underline-offset-4">{name}</a></li>)
        }
      </ul>
    </div>
  </section>
</BaseLayout>
