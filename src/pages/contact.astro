---
import Phone from '@lucide/astro/icons/phone';
import MessageSquare from '@lucide/astro/icons/message-square';
import Clock from '@lucide/astro/icons/clock';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/PageHero.astro';
import QuoteForm from '~/components/QuoteForm.astro';
import { SITE } from '~/config/site';
import CallButton from '~/components/CallButton.astro';
import GoogleMap from '~/components/GoogleMap.astro';

const formOn = SITE.quoteFormEnabled;

const path = '/contact';
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Contact', href: path },
];
---

<BaseLayout
  title="Contact & Free Towing Quote Perth | Quik Tow & Transport"
  description={formOn
    ? 'Call 0419 857 070 for a tow truck anywhere in Perth, 24/7, or send a quick quote request for towing, 4WD recovery or container transport.'
    : 'Call or text 0419 857 070 for a tow truck or a free quote anywhere in Perth, 24/7: towing, 4WD recovery, container and vehicle transport.'}
  path={path}
  og="general"
  crumbs={crumbs}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="Contact"
    h1="Contact Quik Tow & Transport"
    lead={formOn
      ? "For anything urgent, call. A real person answers 24/7. For planned jobs like container moves or vehicle transport, send a quote request and we'll call you back."
      : 'Call or text us on 0419 857 070 any time. A real person answers 24/7, and you get a clear quote on the spot.'}
    chips={false}
  />

  <section class="py-14 sm:py-20">
    <div class="wrap grid gap-10 lg:grid-cols-[22rem_minmax(0,1fr)]">
      <div class="space-y-4">
        <a href={SITE.phoneHref} data-position="contact-card" class="group block rounded-lg bg-hivis p-6 text-ink hover:bg-white">
          <Phone class="size-8" aria-hidden="true" />
          <p class="mt-3 font-display text-lg font-bold uppercase tracking-wide">Call 24/7</p>
          <p class="font-display text-4xl font-extrabold">{SITE.phoneDisplay}</p>
        </a>
        <a href={SITE.smsHref} data-position="contact-card" class="block rounded-lg border border-steel bg-coal p-6 hover:border-hivis">
          <MessageSquare class="size-7 text-hivis" aria-hidden="true" />
          <p class="mt-3 font-display text-lg font-bold uppercase tracking-wide">Text us</p>
          <p class="text-mute">Send your location and what's happened to {SITE.phoneDisplay}.</p>
        </a>
        <div class="rounded-lg border border-steel bg-coal p-6">
          <Clock class="size-7 text-hivis" aria-hidden="true" />
          <p class="mt-3 font-display text-lg font-bold uppercase tracking-wide">Hours</p>
          <p class="text-mute">Open 24 hours, 7 days, including public holidays. We cover every suburb in the Perth metro area.</p>
        </div>
        {
          SITE.email && (
            <p class="text-mute">
              Email: <a href={`mailto:${SITE.email}`} class="text-white underline underline-offset-4">{SITE.email}</a>
            </p>
          )
        }
      </div>

      {
        formOn ? (
          <div id="quote" class="scroll-mt-28 rounded-lg bg-paper p-6 text-ink sm:p-8">
            <h2 class="text-4xl">Get a quote</h2>
            <p class="mt-2 text-slate">Fill this in and we'll call you back with a price. No obligation.</p>
            <div id="quote-error" class="mt-4 hidden rounded-md border-2 border-red-700 bg-red-50 p-4 font-semibold text-red-800 target:block" role="alert">
              Sorry, your request didn't send. Please call us on {SITE.phoneDisplay} instead.
            </div>
            <div class="mt-6">
              <QuoteForm />
            </div>
          </div>
        ) : (
          <div id="quote" class="on-light scroll-mt-28 rounded-lg bg-paper p-6 text-ink sm:p-10">
            <h2 class="text-4xl sm:text-5xl">Get a quote: just call</h2>
            <p class="mt-4 max-w-xl text-lg text-slate">
              The fastest way to a price is a quick call. Tell us where the vehicle or container is, where it's going and what it is, and we'll
              quote you on the spot, with no hidden fees and our best rates guarantee.
            </p>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <CallButton position="contact-quote" variant="dark" size="xl" label="Call" />
              <a
                href={`${SITE.smsHref}?body=${encodeURIComponent('Hi Quik Tow, can I get a quote? Pickup: ')}`}
                data-position="contact-quote"
                class="inline-flex min-h-16 items-center justify-center gap-2 rounded-md border-2 border-ink px-6 font-display text-xl font-bold uppercase tracking-wide text-ink hover:bg-ink hover:text-hivis"
              >
                <MessageSquare class="size-6" aria-hidden="true" /> Text for a quote
              </a>
            </div>
            <ul class="mt-8 space-y-2 text-slate">
              <li><strong class="text-ink">Towing or recovery:</strong> where you are, the make and model, and where it needs to go.</li>
              <li><strong class="text-ink">Containers:</strong> the size, both addresses and any access limits at the delivery site.</li>
              <li><strong class="text-ink">Insurance job:</strong> your insurer and claim number, and we'll bill them directly.</li>
            </ul>
          </div>
        )
      }
    </div>
  </section>

  <section class="pb-14 sm:pb-20" aria-labelledby="map-heading">
    <div class="wrap">
      <h2 id="map-heading" class="text-4xl sm:text-5xl">Find us on Google Maps</h2>
      <GoogleMap class="mt-6" />
    </div>
  </section>
</BaseLayout>
