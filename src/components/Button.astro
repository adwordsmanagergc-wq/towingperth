---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'dark';
  size?: 'md' | 'lg';
  class?: string;
  [key: string]: unknown;
}
const { href, variant = 'secondary', size = 'lg', class: cls = '', ...rest } = Astro.props;
const variants = {
  primary: 'bg-hivis text-ink hover:bg-white',
  secondary: 'border-2 border-white/80 text-white hover:border-hivis hover:text-hivis',
  ghost: 'text-hivis underline decoration-2 underline-offset-4 hover:text-white px-0!',
  dark: 'bg-ink text-white hover:bg-coal',
};
const sizes = { md: 'min-h-12 px-5 text-lg', lg: 'min-h-14 px-6 text-xl' };
---

<a
  href={href}
  class:list={[
    'inline-flex items-center justify-center gap-2 rounded-md font-display font-bold uppercase tracking-wide transition-colors',
    sizes[size],
    variants[variant],
    cls,
  ]}
  {...rest}><slot /></a
>
