---
// Visible breadcrumbs. The matching BreadcrumbList schema comes from the layout's `crumbs` prop.
import ChevronRight from '@lucide/astro/icons/chevron-right';
import type { Crumb } from '~/lib/schema';
interface Props {
  crumbs: Crumb[];
}
const { crumbs } = Astro.props;
---

<nav aria-label="Breadcrumb" class="text-sm">
  <ol class="flex flex-wrap items-center gap-x-1.5 gap-y-1 text-mute">
    {
      crumbs.map((c, i) => (
        <li class="inline-flex items-center gap-1.5">
          {i > 0 && <ChevronRight class="size-3.5 opacity-60" aria-hidden="true" />}
          {i === crumbs.length - 1 ? (
            <span aria-current="page" class="text-white">{c.name}</span>
          ) : (
            <a href={c.href} class="underline-offset-4 hover:text-hivis hover:underline">{c.name}</a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
