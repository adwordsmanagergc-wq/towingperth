---
// Quik Tow & Transport logo (from the original towingperth.com site).
// The artwork is black and green on white, so it sits on a white badge
// to stay legible against the site's dark background.
import { Image } from 'astro:assets';
import logo from '~/assets/images/quik-tow-logo.png';
interface Props {
  class?: string;
  /** Rendered logo height in px (the badge adds padding around it). */
  height?: number;
  alt?: string;
}
const { class: cls = '', height = 40, alt = 'Quik Tow & Transport' } = Astro.props;
const width = Math.round((logo.width / logo.height) * height);
---

<span class:list={['inline-flex rounded-md bg-white px-2 py-1 shadow-sm', cls]}>
  <Image src={logo} alt={alt} width={width} height={height} densities={[1, 2, 3]} format="webp" loading="eager" class="block" />
</span>
