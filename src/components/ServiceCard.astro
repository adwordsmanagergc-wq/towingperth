---
import ChevronRight from '@lucide/astro/icons/chevron-right';
import { Picture } from 'astro:assets';
import type { Photo } from '~/data/photos';
import ServiceIcon from './ServiceIcon.astro';
interface Props {
  href: string;
  title: string;
  blurb: string;
  icon: string;
  headingLevel?: 'h2' | 'h3';
  photo?: Photo;
}
const { href, title, blurb, icon, headingLevel: H = 'h3', photo } = Astro.props;
---

<a
  href={href}
  class="group reveal relative flex h-full flex-col rounded-lg border border-steel bg-coal p-6 transition-colors hover:border-hivis focus-visible:border-hivis"
>
  {
    photo && (
      <Picture
        src={photo.src}
        alt=""
        formats={['avif', 'webp']}
        widths={[400, 640, 800]}
        sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw"
        class="aspect-[16/9] w-full rounded-t-lg object-cover"
        pictureAttributes={{ class: '-mx-6 -mt-6 mb-5 block w-[calc(100%+3rem)] max-w-none' }}
      />
    )
  }
  <span class="mb-5 grid size-14 place-items-center rounded-md bg-hivis text-ink"><ServiceIcon name={icon} /></span>
  <H class="text-2xl text-white sm:text-[1.7rem]">{title}</H>
  <p class="mt-3 flex-1 text-mute">{blurb}</p>
  <span class="mt-5 inline-flex items-center gap-1 font-display text-lg font-bold uppercase tracking-wide text-hivis">
    Learn more <ChevronRight class="size-5 transition-transform group-hover:translate-x-1" aria-hidden="true" />
  </span>
</a>
