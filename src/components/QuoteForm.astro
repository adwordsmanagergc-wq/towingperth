---
// Quote request form. Plain POST to /api/quote, so it works without JavaScript.
// Spam protection: a honeypot field that real people never see or fill in.
interface Props {
  position?: string;
}
const { position = 'contact-page' } = Astro.props;
const field = 'mt-1.5 block min-h-12 w-full rounded-md border-2 border-ink/25 bg-white px-3 py-2.5 text-base text-ink focus:border-ink focus:outline-none';
const label = 'block font-semibold text-ink';
const vehicleTypes = ['Car or SUV', '4WD or ute', 'Van', 'Motorbike', 'Light truck', 'Caravan or trailer', 'Other'];
const serviceTypes = ['Accident towing', 'Breakdown towing', '4WD recovery', 'Shipping container transport', 'Vehicle transport', 'Not sure'];
---

<form action="/api/quote" method="post" data-quote-form data-position={position} class="on-light grid gap-5 sm:grid-cols-2">
  <div>
    <label for="q-name" class={label}>Your name</label>
    <input id="q-name" name="name" type="text" required autocomplete="name" class={field} />
  </div>
  <div>
    <label for="q-phone" class={label}>Mobile number</label>
    <input id="q-phone" name="phone" type="tel" required autocomplete="tel" inputmode="tel" class={field} />
  </div>
  <div>
    <label for="q-pickup" class={label}>Pickup suburb</label>
    <input id="q-pickup" name="pickup" type="text" required class={field} placeholder="e.g. Joondalup" />
  </div>
  <div>
    <label for="q-dropoff" class={label}>Drop-off suburb</label>
    <input id="q-dropoff" name="dropoff" type="text" class={field} placeholder="e.g. Osborne Park" />
  </div>
  <div>
    <label for="q-vehicle" class={label}>Vehicle type</label>
    <select id="q-vehicle" name="vehicle" class={field}>
      {vehicleTypes.map((v) => <option>{v}</option>)}
    </select>
  </div>
  <div>
    <label for="q-service" class={label}>Service</label>
    <select id="q-service" name="service" class={field}>
      {serviceTypes.map((s) => <option>{s}</option>)}
    </select>
  </div>
  <div class="sm:col-span-2">
    <label for="q-notes" class={label}>Anything else we should know? <span class="font-normal text-slate">(optional)</span></label>
    <textarea id="q-notes" name="notes" rows="4" class={field} placeholder="Make and model, whether it rolls, insurer, timing, container size..."></textarea>
  </div>
  <!-- Honeypot: hidden from people and screen readers; bots fill it in. -->
  <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
    <label for="q-company">Company</label>
    <input id="q-company" name="company" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <div class="sm:col-span-2">
    <button type="submit" class="min-h-14 w-full rounded-md bg-ink px-6 font-display text-xl font-bold uppercase tracking-wide text-hivis hover:bg-coal sm:w-auto">
      Send quote request
    </button>
    <p class="mt-3 text-sm text-slate">Need a truck right now? Calling is faster than the form.</p>
  </div>
</form>
