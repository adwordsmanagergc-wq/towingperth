---
import Check from '@lucide/astro/icons/check';
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<li class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-ink/80 px-3.5 py-2 text-sm font-semibold text-white sm:text-base">
  <span class="grid size-5 shrink-0 place-items-center rounded-full bg-hivis text-ink"><Check class="size-3.5" stroke-width={3.5} aria-hidden="true" /></span>
  {label}
</li>
