---
// Conversion tracking without a render-blocking tag manager.
// - Events are pushed to dataLayer immediately, so nothing is lost before GTM loads.
// - GTM (or GA4 directly) loads on first interaction or after 3.5s, whichever comes first.
// Events for Google Ads import: click_to_call, sms_click, quote_form_submit.
import { SITE } from '~/config/site';
const { gtmId, ga4Id } = SITE.analytics;
---

<script is:inline define:vars={{ gtmId, ga4Id }}>
  window.dataLayer = window.dataLayer || [];
  // GA4 without GTM: define gtag now so events queue until gtag.js arrives.
  if (!gtmId && ga4Id) {
    window.gtag = function () {
      window.dataLayer.push(arguments);
    };
    window.gtag('js', new Date());
    window.gtag('config', ga4Id);
  }
  function track(event, params) {
    window.dataLayer.push(Object.assign({ event: event, page_path: location.pathname }, params));
    if (typeof window.gtag === 'function' && !gtmId) window.gtag('event', event, params);
  }
  window.qtTrack = track;

  document.addEventListener(
    'click',
    function (e) {
      var a = e.target.closest && e.target.closest('a[href^="tel:"], a[href^="sms:"]');
      if (!a) return;
      var isTel = a.getAttribute('href').indexOf('tel:') === 0;
      track(isTel ? 'click_to_call' : 'sms_click', {
        link_position: a.getAttribute('data-position') || 'inline',
        link_url: a.getAttribute('href'),
      });
    },
    { capture: true },
  );

  document.addEventListener('submit', function (e) {
    var f = e.target;
    if (f && f.matches && f.matches('form[data-quote-form]')) {
      track('quote_form_submit', { form_position: f.getAttribute('data-position') || 'page' });
    }
  });

  if (gtmId || ga4Id) {
    var loaded = false;
    function load() {
      if (loaded) return;
      loaded = true;
      var s = document.createElement('script');
      s.async = true;
      if (gtmId) {
        window.dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
        s.src = 'https://www.googletagmanager.com/gtm.js?id=' + gtmId;
      } else {
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga4Id;
      }
      document.head.appendChild(s);
    }
    ['pointerdown', 'keydown', 'scroll', 'touchstart'].forEach(function (t) {
      addEventListener(t, load, { once: true, passive: true });
    });
    addEventListener('load', function () {
      setTimeout(load, 3500);
    });
  }
</script>
