---
// Thumb-reach call bar, mobile and tablet only. The body has bottom padding to match.
import MessageSquare from '@lucide/astro/icons/message-square';
import { SITE } from '~/config/site';
import CallButton from './CallButton.astro';
---

<div
  class="fixed inset-x-0 bottom-0 z-50 border-t border-steel bg-ink/[0.97] px-3 pt-2.5 lg:hidden"
  style="padding-bottom: calc(0.625rem + env(safe-area-inset-bottom))"
>
  <div class="mx-auto flex max-w-xl gap-2">
    <CallButton position="mobile-bar" size="lg" label="Call" class="flex-1" />
    <a
      href={`${SITE.smsHref}?body=${encodeURIComponent('Hi Quik Tow, I need a tow. Pickup: ')}`}
      data-position="mobile-bar"
      class="inline-flex min-h-14 w-24 flex-col items-center justify-center rounded-md border-2 border-white/70 text-white"
      aria-label="Text us for a quote"
    >
      <MessageSquare class="size-5" aria-hidden="true" />
      <span class="font-display text-sm font-bold uppercase tracking-wide">Text us</span>
    </a>
  </div>
</div>
